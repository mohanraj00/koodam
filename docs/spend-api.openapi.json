{
  "openapi": "3.0.3",
  "info": {
    "title": "Koodam Spend API",
    "description": "Each path accepts GET and HEAD. Other methods get status 405 with an Allow header.",
    "version": "1"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/runs": {
      "parameters": [
        {"$ref": "#/components/parameters/Limit"},
        {"$ref": "#/components/parameters/Cursor"}
      ],
      "get": {
        "operationId": "listRuns",
        "summary": "List Agent runs and their spend and budgets.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunPage"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "410": {"$ref": "#/components/responses/ExpiredCursor"},
          "502": {"$ref": "#/components/responses/UpstreamFailure"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "head": {
        "operationId": "headRuns",
        "summary": "Check the status of the run list without a body.",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "A valid token is necessary."},
          "403": {"description": "The caller cannot list Agents in a namespace of this server."},
          "400": {"description": "The query is not valid."},
          "410": {"description": "The cursor expired."},
          "502": {"description": "An upstream read failed."},
          "504": {"description": "The request time limit expired."}
        }
      },
      "post": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "put": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "patch": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "delete": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "options": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}}
    },
    "/v1/spend": {
      "parameters": [
        {"$ref": "#/components/parameters/Limit"},
        {"$ref": "#/components/parameters/Cursor"},
        {"$ref": "#/components/parameters/From"},
        {"$ref": "#/components/parameters/To"},
        {"$ref": "#/components/parameters/GroupBy"}
      ],
      "get": {
        "operationId": "listSpend",
        "summary": "List period spend by Agent label or namespace.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PeriodPage"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "410": {"$ref": "#/components/responses/ExpiredCursor"},
          "502": {"$ref": "#/components/responses/UpstreamFailure"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "head": {
        "operationId": "headSpend",
        "summary": "Check the status of the period spend list without a body.",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "A valid token is necessary."},
          "403": {"description": "The caller cannot list Agents in a namespace of this server."},
          "400": {"description": "The query is not valid."},
          "410": {"description": "The cursor expired."},
          "502": {"description": "An upstream read failed."},
          "504": {"description": "The request time limit expired."}
        }
      },
      "post": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "put": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "patch": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "delete": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "options": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}}
    },
    "/v1/budgets": {
      "get": {
        "operationId": "listBudgets",
        "summary": "List the period budgets of the namespaces of the caller.",
        "description": "One item for each namespace that has a SpendBudget, in the order of the server namespaces. The list has no query and no pages.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BudgetPage"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "502": {"$ref": "#/components/responses/UpstreamFailure"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "head": {
        "operationId": "headBudgets",
        "summary": "Check the status of the budget list without a body.",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "A valid token is necessary."},
          "403": {"description": "The caller cannot list Agents in a namespace of this server."},
          "400": {"description": "The query is not valid."},
          "502": {"description": "An upstream read failed."},
          "504": {"description": "The request time limit expired."}
        }
      },
      "post": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "put": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "patch": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "delete": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "options": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}}
    },
    "/v1/runs/{namespace}/{name}": {
      "parameters": [
        {"$ref": "#/components/parameters/Namespace"},
        {"$ref": "#/components/parameters/Name"}
      ],
      "get": {
        "operationId": "getRun",
        "summary": "Read one Agent run with its status conditions, its Job and its pods.",
        "description": "The path has no query. In the viewer mode, the server checks list on Agents in the namespace of the path only.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunDetail"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "502": {"$ref": "#/components/responses/UpstreamFailure"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "head": {
        "operationId": "headRun",
        "summary": "Check the status of one run without a body.",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "A valid token is necessary."},
          "403": {"description": "The caller cannot list Agents in the namespace, or the server does not serve the namespace."},
          "400": {"description": "The query is not valid."},
          "404": {"description": "The run does not exist."},
          "502": {"description": "An upstream read failed."},
          "504": {"description": "The request time limit expired."}
        }
      },
      "post": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "put": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "patch": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "delete": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "options": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}}
    },
    "/v1/runs/{namespace}/{name}/log": {
      "parameters": [
        {"$ref": "#/components/parameters/Namespace"},
        {"$ref": "#/components/parameters/Name"},
        {"$ref": "#/components/parameters/Lines"}
      ],
      "get": {
        "operationId": "getRunLog",
        "summary": "Read the last lines of the agent container of the newest pod of a run, with each credential redacted.",
        "description": "Only the viewer mode serves this path. The server checks list on Agents and get on pods/log in the namespace of the path. The response has at most 262144 log bytes before the redaction.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunLog"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "409": {"$ref": "#/components/responses/NoLogYet"},
          "422": {"description": "The log window exceeds 1 MiB, including up to 256 lines of key context. Long lines at the end of the log can cause this error at any value of the lines parameter. For the planned change to the log read, see [issue #535](https://github.com/mohanraj00/koodam/issues/535).", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "502": {"$ref": "#/components/responses/UpstreamFailure"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "head": {
        "operationId": "headRunLog",
        "summary": "Check the status of the log of a run without a body.",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "A valid token is necessary."},
          "403": {"description": "The server is not in the viewer mode, or the caller cannot list Agents or get pods/log in the namespace."},
          "400": {"description": "The query is not valid."},
          "404": {"description": "The run or its pod does not exist."},
          "409": {"description": "The container has no log yet."},
          "422": {"description": "The log window exceeds 1 MiB, including up to 256 lines of key context. Long lines at the end of the log can cause this error at any value of the lines parameter. For the planned change to the log read, see [issue #535](https://github.com/mohanraj00/koodam/issues/535)."},
          "502": {"description": "An upstream read failed."},
          "504": {"description": "The request time limit expired."}
        }
      },
      "post": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "put": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "patch": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "delete": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "options": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}}
    },
    "/v1/runs/{namespace}/{name}/watch": {
      "parameters": [
        {"$ref": "#/components/parameters/Namespace"},
        {"$ref": "#/components/parameters/Name"}
      ],
      "get": {
        "operationId": "watchRun",
        "summary": "Watch the Agent status of a run as server-sent events.",
        "description": "The server checks list on Agents in the namespace of the path. The first event is a status event with the current status. Then the server sends a status event after each change of the status, and a comment line every 15 s. The event deleted ends the stream when the Agent is deleted. The event end ends the stream after 5 min or when the watch of the API server ends. Then the client connects again, and the server checks the token and the access again. Each event has JSON data: RunStatus for status and deleted, WatchEnd for end.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"text/event-stream": {"schema": {"type": "string", "description": "Server-sent events: retry, status, deleted and end."}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "429": {"$ref": "#/components/responses/TooManyWatches"},
          "502": {"$ref": "#/components/responses/UpstreamFailure"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "head": {
        "operationId": "headRunWatch",
        "summary": "Check the status of the watch of a run without a body.",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "A valid token is necessary."},
          "403": {"description": "The caller cannot list Agents in the namespace."},
          "400": {"description": "The path has a query."},
          "404": {"description": "The run does not exist."},
          "429": {"description": "Too many watches are open."},
          "502": {"description": "An upstream read failed."},
          "504": {"description": "The request time limit expired."}
        }
      },
      "post": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "put": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "patch": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "delete": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "options": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}}
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenAPI",
        "summary": "Read the OpenAPI document.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Document"}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "502": {"$ref": "#/components/responses/UpstreamFailure"},
          "504": {"$ref": "#/components/responses/Timeout"}
        }
      },
      "head": {
        "operationId": "headOpenAPI",
        "summary": "Check the status of the OpenAPI document without a body.",
        "responses": {
          "200": {"description": "OK"},
          "401": {"description": "A valid token is necessary."},
          "403": {"description": "The caller cannot list Agents in a namespace of this server."},
          "502": {"description": "An upstream read failed."},
          "504": {"description": "The request time limit expired."}
        }
      },
      "post": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "put": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "patch": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "delete": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}},
      "options": {"summary": "Not allowed.", "security": [], "responses": {"405": {"$ref": "#/components/responses/MethodNotAllowed"}}}
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Use a signed claim, a configured local token or, with the viewer review, a Kubernetes token."
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Maximum number of items in the page.",
        "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 100}
      },
      "Namespace": {
        "name": "namespace",
        "in": "path",
        "required": true,
        "description": "The namespace of the Agent. It must be a namespace of the server.",
        "schema": {"type": "string", "maxLength": 63}
      },
      "Name": {
        "name": "name",
        "in": "path",
        "required": true,
        "description": "The name of the Agent.",
        "schema": {"type": "string", "maxLength": 253}
      },
      "Lines": {
        "name": "lines",
        "in": "query",
        "required": false,
        "description": "The count of the last log lines. The default is 200.",
        "schema": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 200}
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "The nextCursor value from an earlier page of the same query.",
        "schema": {"type": "string"}
      },
      "From": {
        "name": "from",
        "in": "query",
        "required": true,
        "description": "First UTC date of the period.",
        "schema": {"type": "string", "format": "date"}
      },
      "To": {
        "name": "to",
        "in": "query",
        "required": true,
        "description": "Last UTC date of the period.",
        "schema": {"type": "string", "format": "date"}
      },
      "GroupBy": {
        "name": "groupBy",
        "in": "query",
        "required": true,
        "description": "Group by label:<name>, with a Kubernetes label name, or by namespace.",
        "schema": {"type": "string", "example": "label:koodam.dev/cost-group"}
      }
    },
    "responses": {
      "MethodNotAllowed": {
        "description": "Use GET or HEAD.",
        "headers": {"Allow": {"description": "The permitted methods.", "schema": {"type": "string", "example": "GET, HEAD"}}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "Unauthorized": {
        "description": "A valid token is necessary.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "Forbidden": {
        "description": "The caller cannot list Agents in a namespace of this server.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "BadRequest": {
        "description": "The query is not valid.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "ExpiredCursor": {
        "description": "The cursor expired. Start again with no cursor.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "NotFound": {
        "description": "The run does not exist.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "NoLogYet": {
        "description": "The container has no log yet, for example because it did not start.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "TooManyWatches": {
        "description": "Too many watches are open on the server or for the caller. The Retry-After header gives the wait in seconds.",
        "headers": {"Retry-After": {"schema": {"type": "integer"}}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "UpstreamFailure": {
        "description": "An upstream read failed.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      },
      "Timeout": {
        "description": "The request time limit expired.",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}
      }
    },
    "schemas": {
      "RunPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/Run"}},
          "nextCursor": {"type": "string", "description": "Use this opaque cursor for the next page."}
        }
      },
      "Run": {
        "type": "object",
        "required": ["id", "name", "namespace", "createdAt", "budget"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "namespace": {"type": "string"},
          "createdAt": {"type": "string", "format": "date-time"},
          "phase": {"type": "string", "description": "Pending, Running, Succeeded or Failed. Absent before the first status."},
          "models": {"type": "array", "items": {"type": "string"}, "description": "The gateway models of the run."},
          "startedAt": {"type": "string", "format": "date-time", "description": "The start time of the run Job."},
          "completedAt": {"type": "string", "format": "date-time", "description": "The end time of the run Job."},
          "spend": {"type": "number", "format": "double", "description": "Spend in USD."},
          "budget": {"type": "number", "format": "double", "description": "Declared budget in USD."},
          "remainingBudget": {
            "type": "number",
            "format": "double",
            "description": "Budget minus spend in USD, with a minimum of zero."
          }
        }
      },
      "PeriodPage": {
        "type": "object",
        "required": ["from", "to", "groupBy", "items"],
        "properties": {
          "from": {"type": "string", "format": "date"},
          "to": {"type": "string", "format": "date"},
          "groupBy": {"type": "string"},
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/Group"}},
          "nextCursor": {"type": "string", "description": "Use this opaque cursor for the next page."}
        }
      },
      "Group": {
        "type": "object",
        "required": ["labelValue", "spend"],
        "properties": {
          "labelValue": {"type": "string", "description": "The label value, or the namespace for groupBy=namespace."},
          "spend": {"type": "number", "format": "double", "description": "Spend in USD."},
          "budget": {
            "type": "number",
            "format": "double",
            "description": "Absent when no period budget is declared."
          },
          "remainingBudget": {
            "type": "number",
            "format": "double",
            "description": "Absent when no period budget is declared."
          }
        }
      },
      "BudgetPage": {
        "type": "object",
        "required": ["items"],
        "properties": {"items": {"type": "array", "items": {"$ref": "#/components/schemas/Budget"}}}
      },
      "Budget": {
        "type": "object",
        "required": ["namespace", "period", "periodStart", "periodEnd", "limit", "spend", "reserved", "remaining", "exceeded", "waitingRuns"],
        "properties": {
          "namespace": {"type": "string"},
          "period": {"type": "string", "enum": ["Day", "Month"], "description": "A UTC day or a UTC month."},
          "periodStart": {"type": "string", "format": "date-time", "description": "The start of the current period."},
          "periodEnd": {"type": "string", "format": "date-time", "description": "The end of the current period."},
          "limit": {"type": "number", "format": "double", "description": "The spend limit of the period in USD."},
          "spend": {"type": "number", "format": "double", "description": "The settled spend in USD of the Agent runs that started in the period and ended."},
          "reserved": {"type": "number", "format": "double", "description": "The sum in USD of the budgets of the active runs of the period."},
          "remaining": {"type": "number", "format": "double", "description": "The limit minus the spend and the reserved budgets in USD, with a minimum of zero."},
          "exceeded": {"type": "boolean", "description": "True if the last run that the controller checked had to wait."},
          "waitingRuns": {"type": "integer", "format": "int32", "description": "The count of the runs that waited at the last check."}
        }
      },
      "RunDetail": {
        "type": "object",
        "required": ["id", "name", "namespace", "conditions", "pods"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "namespace": {"type": "string"},
          "phase": {"type": "string", "enum": ["Pending", "Running", "Succeeded", "Failed"]},
          "startedAt": {"type": "string", "format": "date-time"},
          "completedAt": {"type": "string", "format": "date-time"},
          "conditions": {"type": "array", "items": {"$ref": "#/components/schemas/Condition"}, "description": "The status conditions of the Agent."},
          "job": {"$ref": "#/components/schemas/RunJob"},
          "pods": {"type": "array", "maxItems": 10, "items": {"$ref": "#/components/schemas/RunPod"}, "description": "The pods of the Job, newest first."}
        }
      },
      "Condition": {
        "type": "object",
        "required": ["type", "status", "lastTransitionTime"],
        "properties": {
          "type": {"type": "string"},
          "status": {"type": "string", "enum": ["True", "False", "Unknown"]},
          "reason": {"type": "string"},
          "message": {"type": "string"},
          "lastTransitionTime": {"type": "string", "format": "date-time"}
        }
      },
      "RunJob": {
        "type": "object",
        "description": "The run Job. The item is not there if the Agent has no Job, or if the Agent does not control the Job of that name.",
        "required": ["name", "active", "succeeded", "failed", "conditions"],
        "properties": {
          "name": {"type": "string"},
          "active": {"type": "integer", "format": "int32"},
          "succeeded": {"type": "integer", "format": "int32"},
          "failed": {"type": "integer", "format": "int32"},
          "startedAt": {"type": "string", "format": "date-time"},
          "completedAt": {"type": "string", "format": "date-time"},
          "conditions": {"type": "array", "items": {"$ref": "#/components/schemas/Condition"}}
        }
      },
      "RunPod": {
        "type": "object",
        "required": ["name", "phase", "containers"],
        "properties": {
          "name": {"type": "string"},
          "phase": {"type": "string"},
          "startedAt": {"type": "string", "format": "date-time"},
          "containers": {"type": "array", "items": {"$ref": "#/components/schemas/RunContainer"}}
        }
      },
      "RunContainer": {
        "type": "object",
        "description": "The state of a container. It has no message, because the termination message comes from the code of the run.",
        "required": ["name", "ready", "restartCount", "state"],
        "properties": {
          "name": {"type": "string"},
          "init": {"type": "boolean"},
          "ready": {"type": "boolean"},
          "restartCount": {"type": "integer", "format": "int32"},
          "state": {"type": "string", "enum": ["waiting", "running", "terminated"]},
          "reason": {"type": "string"},
          "exitCode": {"type": "integer", "format": "int32"}
        }
      },
      "RunLog": {
        "type": "object",
        "required": ["pod", "container", "lines", "truncated"],
        "properties": {
          "pod": {"type": "string"},
          "container": {"type": "string", "description": "The first container of the pod, which runs the agent."},
          "lines": {"type": "array", "maxItems": 1000, "items": {"type": "string"}, "description": "The last lines, oldest first. Each credential that a pattern matches is [redacted]. Control characters are removed."},
          "truncated": {"type": "boolean", "description": "True if the log has more lines than the response."}
        }
      },
      "RunStatus": {
        "type": "object",
        "required": ["id", "name", "namespace", "conditions"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "namespace": {"type": "string"},
          "phase": {"type": "string"},
          "startedAt": {"type": "string", "format": "date-time"},
          "completedAt": {"type": "string", "format": "date-time"},
          "conditions": {"type": "array", "items": {"$ref": "#/components/schemas/Condition"}}
        }
      },
      "WatchEnd": {
        "type": "object",
        "required": ["reason"],
        "properties": {"reason": {"type": "string", "enum": ["timeLimit", "watchEnded", "accessEnded", "accessCheckFailed"]}}
      },
      "Problem": {
        "type": "object",
        "required": ["error"],
        "properties": {"error": {"type": "string"}}
      },
      "Document": {"type": "object"}
    }
  }
}
