{
  "name": "menu",
  "description": "A button that opens a menu of named choices. A selection closes the menu and returns focus to the button before the selection event. If the menu closes with focus inside it, focus returns to the button.",
  "ai_content": false,
  "parts": [
    {"name": "copy", "description": "Button that copies text.", "guardrail": true},
    {"name": "copy-status", "description": "Result of the copy operation.", "guardrail": true},
    {"name": "details", "description": "Control and technical details of a refusal.", "guardrail": true},
    {"name": "item", "description": "Button for one menu choice.", "guardrail": true},
    {"name": "menu", "description": "Container for the menu choices.", "guardrail": true},
    {"name": "next", "description": "Next step after a refusal.", "guardrail": true},
    {"name": "reason", "description": "Reason for a refusal.", "guardrail": true},
    {"name": "trigger", "description": "Button that opens the menu.", "guardrail": true}
  ],
  "data": {
    "label": {"type": "text", "required": true, "min_length": 1, "size": "line"},
    "items": {
      "type": "list", "required": true, "min_items": 1, "max_items": 20,
      "items": {
        "type": "record",
        "fields": {
          "label": {"type": "text", "required": true, "min_length": 1, "size": "line"},
          "name": {"type": "text", "required": true, "min_length": 1, "size": "short", "format": "name"}
        }
      }
    }
  },
  "states": ["+open", "+refused"],
  "tokens": ["+color.surface", "+color.focus", "+space.2", "+radius.2", "+motion.fast"],
  "accessibility": {
    "role": "menu", "name": {"field": "label"},
    "keyboard": ["Tab", "Shift+Tab", "Enter", "Space", "Escape", "ArrowUp", "ArrowDown", "Home", "End"]
  }
}
