{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohanraj00/mugham/catalog/schema/short.schema.json",
  "title": "Mugham component contract, format 3 (the short form of format 2)",
  "type": "object",
  "required": ["name", "description", "data"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": 3},
    "name": {"$ref": "#/$defs/name"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
    "kind": {"enum": ["primitive", "component"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 300},
    "ai_content": {"type": "boolean"},
    "slots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {"authorship": {"$ref": "#/$defs/slot"}, "citation": {"$ref": "#/$defs/slot"}}
    },
    "data": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {"$ref": "#/$defs/field_name"},
      "additionalProperties": {"$ref": "#/$defs/field"}
    },
    "states": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\+?(default|empty|loading|disabled|confirm|pending|done|error|refused|expanded|collapsed)$"
      }
    },
    "tokens": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^\\+?[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*){1,3}$"}
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["article", "button", "form", "group", "list", "region", "status", "textbox", "none"]},
        "name": {
          "oneOf": [
            {
              "type": "object",
              "required": ["field"],
              "additionalProperties": false,
              "properties": {"field": {"$ref": "#/$defs/field_name"}}
            },
            {
              "type": "object",
              "required": ["text"],
              "additionalProperties": false,
              "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 80}}
            }
          ]
        },
        "keyboard": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Tab",
              "Shift+Tab",
              "Enter",
              "Space",
              "Escape",
              "ArrowUp",
              "ArrowDown",
              "ArrowLeft",
              "ArrowRight",
              "Home",
              "End"
            ]
          }
        },
        "forced_colors": {"const": true},
        "reduced_motion": {"const": true}
      },
      "minProperties": 1
    }
  },
  "$defs": {
    "name": {"type": "string", "maxLength": 40, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "field_name": {"type": "string", "maxLength": 40, "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 80},
    "slot": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {"required": {"type": "boolean"}}
    },
    "size": {"type": "string", "maxLength": 40, "pattern": "^[a-z][a-z0-9]*$"},
    "field": {
      "oneOf": [
        {"$ref": "#/$defs/text_field"},
        {"$ref": "#/$defs/number_field"},
        {"$ref": "#/$defs/boolean_field"},
        {"$ref": "#/$defs/date_field"},
        {"$ref": "#/$defs/enum_field"},
        {"$ref": "#/$defs/list_field"},
        {"$ref": "#/$defs/component_field"},
        {"$ref": "#/$defs/components_field"}
      ]
    },
    "scalar_field": {
      "oneOf": [
        {"$ref": "#/$defs/text_field"},
        {"$ref": "#/$defs/number_field"},
        {"$ref": "#/$defs/boolean_field"},
        {"$ref": "#/$defs/date_field"},
        {"$ref": "#/$defs/enum_field"}
      ]
    },
    "text_field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "text"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "min_length": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_length": {"type": "integer", "minimum": 1, "maximum": 10000},
        "size": {"$ref": "#/$defs/size"}
      }
    },
    "number_field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["number", "integer"]},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "boolean_field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "boolean"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"}
      }
    },
    "date_field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "date"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"}
      }
    },
    "enum_field": {
      "type": "object",
      "required": ["type", "values"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "enum"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "values": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/field_name"}}
      }
    },
    "list_field": {
      "type": "object",
      "required": ["type", "items", "max_items"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "list"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 500},
        "items": {
          "oneOf": [
            {"$ref": "#/$defs/scalar_field"},
            {"$ref": "#/$defs/component_field"},
            {"$ref": "#/$defs/components_field"}
          ]
        }
      }
    },
    "component_field": {
      "type": "object",
      "required": ["type", "name"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "component"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "name": {"$ref": "#/$defs/name"}
      }
    },
    "components_field": {
      "type": "object",
      "required": ["type", "names"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "component"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "names": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}}
      }
    },
    "defaults": {
      "type": "object",
      "required": ["format", "contract", "field", "item", "sizes"],
      "additionalProperties": false,
      "properties": {
        "format": {"const": 3},
        "contract": {
          "type": "object",
          "required": ["version", "kind", "ai_content", "slots", "states", "tokens", "accessibility"],
          "additionalProperties": false,
          "properties": {
            "version": {},
            "kind": {},
            "ai_content": {"type": "boolean"},
            "slots": {"type": "object"},
            "states": {"type": "array"},
            "tokens": {"type": "array"},
            "accessibility": {"type": "object"}
          }
        },
        "field": {"$ref": "#/$defs/tier"},
        "item": {"$ref": "#/$defs/tier"},
        "sizes": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {"$ref": "#/$defs/size"},
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 10000}
        }
      }
    },
    "tier": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": false,
      "properties": {"required": {"type": "boolean"}}
    }
  }
}
