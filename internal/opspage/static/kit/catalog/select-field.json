{
  "name": "select-field",
  "kind": "primitive",
  "description": "A labeled combobox for one choice. Each choice is unique, and a given value must be one of the choices. A list of more than seven choices has a search box. The search matches text in any part of a choice and ignores case. The field announces when there is no match.",
  "ai_content": false,
  "field": true,
  "parts": [
    {"name": "control", "description": "Button that opens the choices.", "guardrail": true},
    {"name": "copy", "description": "Button that copies text.", "guardrail": true},
    {"name": "copy-status", "description": "Result of the copy operation.", "guardrail": true},
    {"name": "details", "description": "Control and technical details of a refusal.", "guardrail": true},
    {"name": "edit-type", "description": "Choices for the type of edit.", "guardrail": true},
    {"name": "label", "description": "Label of the field.", "guardrail": true},
    {"name": "listbox", "description": "List of available choices.", "guardrail": true},
    {"name": "next", "description": "Next step after a refusal.", "guardrail": true},
    {"name": "option", "description": "One available choice.", "guardrail": true},
    {"name": "popup", "description": "Container for the list of choices.", "guardrail": true},
    {"name": "problem", "description": "Reason that a field value is invalid.", "guardrail": true},
    {"name": "reason", "description": "Reason for a refusal or an edit error.", "guardrail": true},
    {"name": "search", "description": "Input that filters the choices.", "guardrail": true},
    {"name": "status", "description": "Result of the search.", "guardrail": true},
    {"name": "value", "description": "Selected choice or prompt to choose.", "guardrail": true}
  ],
  "data": {
    "name": {"type": "text", "size": "short"},
    "label": {"type": "text", "required": true, "min_length": 1, "size": "line"},
    "value": {"type": "text", "size": "line", "editable": true},
    "choices": {
      "type": "list",
      "required": true,
      "max_items": 500,
      "items": {"type": "text", "label": "Choice", "min_length": 1, "size": "line"}
    },
    "hint": {"type": "text", "size": "summary"},
    "error": {"type": "text", "size": "summary"},
    "disabled": {"type": "boolean"},
    "typed": {"type": "boolean"}
  },
  "states": ["+disabled", "+error"],
  "tokens": [
    "+color.surface", "+color.text-muted", "+color.focus", "+color.danger", "+space.1",
    "+space.2", "+radius.1", "+type.caption", "+type.weight-strong", "+motion.fast"
  ],
  "accessibility": {
    "role": "combobox",
    "name": {"field": "label"},
    "keyboard": ["Tab", "Shift+Tab", "Enter", "Space", "Escape", "ArrowUp", "ArrowDown", "Home", "End"]
  }
}
